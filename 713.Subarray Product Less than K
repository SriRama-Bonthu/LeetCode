class Solution {
    public int numSubarrayProductLessThanK(int[] nums,int k) {
        if(k<=1){
            return 0;
        }
        int i=0;
        int s=0;
        long pro=1;
        for (int j=0;j<nums.length;j++) {
            pro=pro*nums[j];
            while(pro>=k && i<=j) {
                pro=pro/nums[i];
                i++;
            }
            s+=(j-i+1);
        }
        return s;
    }
}
