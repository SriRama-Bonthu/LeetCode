class Solution {
    static class Pair {
    int dr, dc;

    Pair(int dr, int dc) {
        this.dr = dr;
        this.dc = dc;
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Pair)) return false;

        Pair p = (Pair) obj;
        return this.dr == p.dr && this.dc == p.dc;
    }

    @Override
    public int hashCode() {
        return 31 * dr + dc;
    }
}
    public int largestOverlap(int[][] img1, int[][] img2) {
        int r1=0;
        int c1=0;
        int r2=0;
        int c2=0;
        int n=img1.length;
        HashMap<Pair,Integer> hm=new HashMap<>();
        for(r1=0;r1<n;r1++){
            for(c1=0;c1<n;c1++){
                if(img1[r1][c1]==0){
                    continue;
                }
                for(r2=0;r2<n;r2++){
                    for(c2=0;c2<n;c2++){
                        if(img2[r2][c2]==1){
                            int dr=r2-r1;
                            int dc=c2-c1;
                            Pair p=new Pair(dr,dc);
                            hm.put(p,hm.getOrDefault(p,0)+1);
                        }
                    }
                }
            }
        }
        int maxvalue=0;
        for(int i:hm.values()){
            maxvalue=Math.max(maxvalue,i);
        }
        return maxvalue;
    }
}
