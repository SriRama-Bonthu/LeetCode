class Solution {
    public long countCommas(long n) {
        if(n>=1000 && n<1000000){
            return n-999;
        }
        else if(n>=1000000 && n<1000000000){
            long res=(n-999999);
            return (res*2)+999999-999;
        }
        else if(n>=1000000000 && n<1e12){
            long res=(n-999999999);
            return (res*3)+((999999999-999999)*2)+999000;
        }
        else if(n>=1e12){
            double res=n-(Math.pow(10,12)-1);
            if(n==1e15){
                return (long)((res*4)+(((1e12-1)-999999999)*3)+((999999999-999999)*2)+999001);
            }
            return (long)((res*4)+(((1e12-1)-999999999)*3)+((999999999-999999)*2)+999000);
        }
        return 0;
    }
}
