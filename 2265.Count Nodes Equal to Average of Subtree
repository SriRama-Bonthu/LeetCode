/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    int ans=0;
    public int[] dfs(TreeNode r){
        if(r==null){
            return new int[]{0,0};
        }
        int[] left=dfs(r.left);
        int[] right=dfs(r.right);
        int sum=left[0]+right[0]+r.val;
        int c=left[1]+right[1]+1;
        if(sum/c==r.val){
            ans++;
        }
        return new int[]{sum,c};
    }
    public int averageOfSubtree(TreeNode root) {
        dfs(root);
        return ans;       
    }
}
