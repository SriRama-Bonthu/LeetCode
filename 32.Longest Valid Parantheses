class Solution {
    public int longestValidParentheses(String s) {
        int l=0;
        int r=0;
        int max=0;
        for(char ch:s.toCharArray()){
            if(ch=='('){
                l++;
            }
            else{
                r++;
            }
            if(l==r){
                max=Math.max(max,l+r);
            }
            if(r>l){
                r=0;
                l=0;
            }
        }
        l=0;
        r=0;
        for(int i=s.length()-1;i>=0;i--){
            if(s.charAt(i)=='('){
                l++;
            }
            else{
                r++;
            }
            if(l==r){
                max=Math.max(max,l+r);
            }
            else if(l>r){
                l=0;
                r=0;
            }
        }
        return max;
    }
}
